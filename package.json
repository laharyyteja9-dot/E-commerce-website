{
  "name": "e-commerce-website",
  "version": "1.0.0",
  "description": "E-Commerce Order & Recommendation System (Node.js + MongoDB)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently \"nodemon src/server.js\" \"cd client && npm run dev\"",
    "dev:server": "nodemon src/server.js",
    "dev:client": "cd client && npm run dev",
    "seed": "node scripts/seed.js",
    "indexes": "node scripts/create-indexes.js"
  },
  "keywords": [
    "mongodb",
    "ecommerce",
    "express",
    "orders",
    "recommendations"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^8.4.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "concurrently": "^8.2.0"
  }
}
